# Public package: Quartus sources, runtime MRAs, and upstream notices.
# Keep .hex/.mem/.mif files: several are required FPGA initialization tables.

# Quartus generated databases, reports, GUI state, and programming files
/db/
/incremental_db/
/output_files/
/work/
/work_*/
/modelsim.ini
*.qdb
*.qtl
*.qpg
*.rpt
*.summary
*.smsg
*.qws
*.done
*.pin
*.jdi
*.sld
*.sof
# RBFs are local build artifacts, including the old candidate in releases/.
# Publish only separately verified binaries as release assets.
*.rbf
/c5_pin_model_dump.txt
/cr_ie_info.json

# Both files are regenerated by the required sys/build_id.tcl pre-flow script.
/build_id.v
/jtag.cdf

# Unused PLL simulation/GUI sidecars; retain all synthesis .v/.qip/IP sources.
/raizingpll.xml
/rtl/raizingpll_sim.f
/rtl/raizingpll_sim/
/rtl/raizingpll.bsf
/rtl/raizingpll.ppf
/rtl/raizingpll.sip
/rtl/raizingpll.spd

# Local engineering workspace (preserved on disk, not needed to build/run)
/AGENTS.md
/docs/
/tools/
/sim/
/cfg/
/snap/
/build/
/captures/
/tmp/
/.codex-backups/

# Vendored development tools, other FPGA targets, and verification suites.
# Keep the upstream HDL, LICENSE, README, and provenance files untouched.
/rtl/modules/jtframe/asm/
/rtl/modules/jtframe/bin/
/rtl/modules/jtframe/cc/
/rtl/modules/jtframe/cfg/
/rtl/modules/jtframe/devops/
/rtl/modules/jtframe/doc/
/rtl/modules/jtframe/mame/
/rtl/modules/jtframe/src/
/rtl/modules/jtframe/syn/
/rtl/modules/jtframe/target/
/rtl/modules/jtframe/ver/
/rtl/modules/jtframe/verilator/
/rtl/modules/jtframe/hdl/ver/
/rtl/modules/jt6295/cc/
/rtl/modules/jt6295/cfg/
/rtl/modules/jt6295/doc/
/rtl/modules/jt6295/src/
/rtl/modules/jt6295/ver/
/rtl/modules/fx68k/cfg/
/rtl/modules/fx68k/hdl/verilator/

